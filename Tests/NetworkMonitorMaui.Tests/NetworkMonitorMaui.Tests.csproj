<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.130" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../NetworkMonitorLib/NetworkMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Utils/MeasurementDisplayConverter.cs" Link="Utils/MeasurementDisplayConverter.cs" />
    <Compile Include="../../Services/IUiDispatcher.cs" Link="Services/IUiDispatcher.cs" />
    <Compile Include="../../Services/MainThreadDispatcher.cs" Link="Services/MainThreadDispatcher.cs" />
    <Compile Include="../../Services/ServiceInitializer.cs" Link="Services/ServiceInitializer.cs" />
    <Compile Include="../../Services/IDeviceContextService.cs" Link="Services/IDeviceContextService.cs" />
    <Compile Include="../../Services/IRootNamespaceProvider.cs" Link="Services/IRootNamespaceProvider.cs" />
    <Compile Include="../../Services/DialogService.cs" Link="Services/DialogService.cs" />
    <Compile Include="../../ViewModels/BasePopupViewModel.cs" Link="ViewModels/BasePopupViewModel.cs" />
    <Compile Include="../../ViewModels/NetworkMonitorViewModel.cs" Link="ViewModels/NetworkMonitorViewModel.cs" />
    <Compile Include="../../ViewModels/MainPageViewModel.cs" Link="ViewModels/MainPageViewModel.cs" />
    <Compile Include="../../ViewModels/ConfigPageViewModel.cs" Link="ViewModels/ConfigPageViewModel.cs" />
    <Compile Include="../../ViewModels/ProcesorStatesViewModel.cs" Link="ViewModels/ProcesorStatesViewModel.cs" />
    <Compile Include="../../ViewModels/ScanProcessorStatesViewModel.cs" Link="ViewModels/ScanProcessorStatesViewModel.cs" />
    <Compile Include="../../ViewModels/EventToCommandBehavior.cs" Link="ViewModels/EventToCommandBehavior.cs" />
    <Compile Include="../../Controls/IColorResource.cs" Link="Controls/IColorResource.cs" />
    <Compile Include="../../Helpers/MauiProgramHelper.cs" Link="Helpers/MauiProgramHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
