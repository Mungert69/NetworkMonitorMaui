<Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
                <TargetFrameworks>net9.0-android</TargetFrameworks>
                <UseMaui>true</UseMaui>
                <ImplicitUsings>enable</ImplicitUsings>
                <Nullable>enable</Nullable>
                <AssemblyName>NetworkMonitorMaui</AssemblyName>
                <RootNamespace>NetworkMonitor.Maui</RootNamespace>
                <!-- Display name -->
                <ApplicationDisplayVersion>0.0.3</ApplicationDisplayVersion>
                <ApplicationVersion>3</ApplicationVersion>
                <DefineConstants>ANDROID</DefineConstants>
                <AndroidSdkDirectory>/usr/lib/android-sdk</AndroidSdkDirectory>
                <!--
  <NoWarn>CS8600;CS8602;CS8603;CS8604;CS8618;CS0067;CS0414;CA1416;CA1422</NoWarn>

  Suppressed warnings:
    - CS8600, CS8602, CS8603, CS8604, CS8618: Nullable reference type warnings (null assignment, dereference, uninitialized non-nullable fields)
    - CS0067: Unused event
    - CS0414: Assigned but unused private field
    - CA1416, CA1422: Platform-specific API usage and obsoleted API usage

  This keeps build output clean but may hide potential issues.
-->
                <NoWarn>CS8600;CS8602;CS8603;CS8604;CS8618;CS0067;CS0414;CA1416;CA1422</NoWarn>
        </PropertyGroup>


        <ItemGroup>
                <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
                <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
                <PackageReference Include="CommunityToolkit.Maui" Version="11.2.0" />
                <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
                <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.110" />
                <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.110" />
                <PackageReference Include="Microsoft.Maui.Core" Version="9.0.110" />
                <PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.110" />
                <PackageReference Include="Microsoft.Maui.Graphics" Version="9.0.110" />
                <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.9" />
                <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.9" />
                <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.9" />
                <PackageReference Include="Microsoft.JSInterop" Version="9.0.9" />

        </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\NetworkMonitorProcessor\NetworkMonitorProcessor-Maui-Android.csproj" />
		<ProjectReference Include="..\NetworkMonitorLib\NetworkMonitor-Maui-Android.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Tests\**\*.cs" />
		<None Remove="Tests\**\*" />
	</ItemGroup>

</Project>
