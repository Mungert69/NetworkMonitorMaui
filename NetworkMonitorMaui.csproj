<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseMaui>true</UseMaui>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>NetworkMonitorMaui</AssemblyName>
        <RootNamespace>NetworkMonitor.Maui</RootNamespace>

        <ApplicationDisplayVersion>0.0.3</ApplicationDisplayVersion>
        <ApplicationVersion>3</ApplicationVersion>
        <DefineConstants>WINDOWS</DefineConstants>
    </PropertyGroup>

    <!-- Optional: keep these excludes -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);openssl\**\*</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
       
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
        <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="MetroLog.Maui" Version="2.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NetworkMonitorProcessorAgent\NetworkMonitorProcessor-Maui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Tests\**\*.cs" />
        <None Remove="Tests\**\*" />
    </ItemGroup>
</Project>
